@model Zwemclub.Models.Wedstrijd

@{
    ViewData["Title"] = "Wedstrijddetails";

    var plaats = ViewData["Plaats"] as Zwemclub.Models.Plaats;
}

<div class="details-pagina">
    <div class="details-kruimelpad">
        Beheer / Wedstrijden / <strong>Details</strong>
    </div>

    <div class="details-hero">
        <div class="details-hero-inhoud">
            <div class="details-label">
                Wedstrijddetails
            </div>

            <h1 class="details-titel">
                @Model.Naam
            </h1>

            <p class="details-ondertitel">
                Bekijk hier de wedstrijdgegevens en de locatie.
            </p>
        </div>

        <a asp-controller="WedstrijdBeheer"
           asp-action="Index"
           class="details-terug">
            ← Terug naar overzicht
        </a>
    </div>

    <div class="details-inhoud">
        <section class="details-paneel">
            <div class="details-paneel-header">
                <div class="details-nummer">01</div>

                <div>
                    <h2>Wedstrijdgegevens</h2>
                    <p>Datum, deadline en wedstrijdlink</p>
                </div>
            </div>

            <div class="details-datumkaart">
                <div class="details-datumblok">
                    <span class="details-dag">
                        @Model.Datum.ToString("dd")
                    </span>

                    <span class="details-maand">
                        @Model.Datum.ToString("MMM")
                    </span>
                </div>

                <div class="details-datumtekst">
                    <span>Datum wedstrijd</span>

                    <strong>
                        @Model.Datum.ToString("dd/MM/yyyy")
                    </strong>
                </div>
            </div>

            <div class="details-velden">
                <div class="details-veld details-veld-breed">
                    <span>Deadline inschrijving</span>

                    <strong>
                        @Model.DeadlineInschrijven.ToString("dd/MM/yyyy HH:mm")
                    </strong>
                </div>

                <div class="details-veld details-veld-breed">
                    <span>Wedstrijdlink</span>

                    @if (string.IsNullOrWhiteSpace(Model.UrlWedstrijd))
                    {
                        <strong>Geen link beschikbaar</strong>
                    }
                    else
                    {
                        <strong>@Model.UrlWedstrijd</strong>
                    }
                </div>
            </div>
        </section>

        <section class="details-paneel">
            <div class="details-paneel-header">
                <div class="details-nummer">02</div>

                <div>
                    <h2>Locatie</h2>
                    <p>Waar de wedstrijd plaatsvindt</p>
                </div>
            </div>

            @if (plaats == null)
            {
                <p class="details-opmerking">
                    Er is geen locatie gevonden voor deze wedstrijd.
                </p>
            }
            else
            {
                <div class="details-veld">
                    <span>Naam locatie</span>
                    <strong>@plaats.Naam</strong>
                </div>

                <div class="details-scheiding"></div>

                <div class="details-velden">
                    <div class="details-veld details-veld-breed">
                        <span>Adres</span>
                        <strong>@plaats.Straat @plaats.HuisNummer</strong>
                    </div>

                    <div class="details-veld">
                        <span>Gemeente</span>
                        <strong>@plaats.Postcode @plaats.Gemeente</strong>
                    </div>

                    <div class="details-veld">
                        <span>Land</span>

                        @if (string.IsNullOrWhiteSpace(plaats.Land))
                        {
                            <strong>Niet opgegeven</strong>
                        }
                        else
                        {
                            <strong>@plaats.Land</strong>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>