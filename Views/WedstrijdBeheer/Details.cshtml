@model Zwemclub.Models.Wedstrijd

@{
    ViewData["Title"] = "Wedstrijddetails";

    var plaats = ViewData["Plaats"] as Zwemclub.Models.Plaats;
}

<style>
    .details-pagina {
        max-width: 1050px;
        margin: 35px auto 60px;
        padding: 32px;
        border: 1px solid #D8EAF2;
        border-radius: 24px;
        background: linear-gradient( 145deg, #E6F3FA 0%, #F1F8FB 55%, #E4F1F7 100% );
        box-shadow: 0 18px 50px rgba(11, 31, 59, 0.08);
        font-family: Arial, Helvetica, sans-serif;
        color: #0B1F3B;
    }

    .details-kruimelpad {
        margin-bottom: 20px;
        color: #60758A;
        font-size: 13px;
    }

        .details-kruimelpad strong {
            color: #0B1F3B;
        }

    /* Donkerblauwe bovenkant */

    .details-hero {
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding: 38px;
        border-radius: 18px;
        background: linear-gradient( 120deg, #0B1F3B 0%, #10345C 65%, #14537A 100% );
        box-shadow: 0 14px 28px rgba(11, 31, 59, 0.18);
        color: #FFFFFF;
    }

        .details-hero::after {
            content: "";
            position: absolute;
            right: -80px;
            bottom: -190px;
            width: 370px;
            height: 370px;
            border: 45px solid rgba(70, 226, 208, 0.08);
            border-radius: 50%;
            pointer-events: none;
        }

    .details-hero-inhoud,
    .details-terug {
        position: relative;
        z-index: 1;
    }

    .details-label {
        margin-bottom: 12px;
        color: #46E2D0;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.6px;
        text-transform: uppercase;
    }

    .details-titel {
        margin: 0 0 12px;
        color: #FFFFFF;
        font-size: 38px;
        font-weight: 700;
        letter-spacing: -1px;
        line-height: 1.1;
    }

    .details-ondertitel {
        max-width: 500px;
        margin: 0;
        color: #B9CEDD;
        font-size: 15px;
        line-height: 1.6;
    }

    .details-terug {
        flex-shrink: 0;
        padding: 12px 17px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.08);
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

        .details-terug:hover {
            border-color: #46E2D0;
            background: rgba(70, 226, 208, 0.12);
            color: #FFFFFF;
        }

    /* Kaarten */

    .details-inhoud {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 22px;
    }

    .details-paneel {
        min-width: 0;
        padding: 27px;
        border: 1px solid #DDEBF2;
        border-radius: 16px;
        background: #FFFFFF;
        box-shadow: 0 12px 30px rgba(25, 69, 98, 0.09);
    }

    .details-paneel-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 24px;
    }

    .details-nummer {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #EAF4FF;
        color: #1769E8;
        font-size: 13px;
        font-weight: 700;
    }

    .details-paneel-header h2 {
        margin: 0 0 4px;
        font-size: 17px;
        font-weight: 700;
    }

    .details-paneel-header p {
        margin: 0;
        color: #60758A;
        font-size: 12px;
    }

    /* Datum */

    .details-datumkaart {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 22px;
        padding: 17px;
        border-radius: 12px;
        background: #E7F3FC;
    }

    .details-datumblok {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        width: 62px;
        height: 62px;
        border-radius: 11px;
        background: #1769E8;
        color: #FFFFFF;
    }

    .details-dag {
        font-size: 22px;
        font-weight: 700;
        line-height: 1;
    }

    .details-maand {
        margin-top: 5px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .details-datumtekst span,
    .details-veld span {
        display: block;
        margin-bottom: 6px;
        color: #60758A;
        font-size: 12px;
    }

    .details-datumtekst strong,
    .details-veld strong {
        display: block;
        overflow-wrap: anywhere;
        color: #0B1F3B;
        font-size: 14px;
        line-height: 1.5;
    }

    /* Gegevens */

    .details-velden {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .details-veld-breed {
        grid-column: 1 / -1;
    }

    .details-scheiding {
        height: 1px;
        margin: 22px 0;
        background: #EDF2F5;
    }

    .details-opmerking {
        margin: 0;
        color: #60758A;
        font-size: 14px;
        line-height: 1.6;
    }

    /* Tablet en gsm */

    @@media (max-width: 750px) {
        .details-inhoud {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .details-pagina {
            margin: 20px auto 40px;
            padding: 16px;
        }

        .details-hero {
            flex-direction: column;
            padding: 27px;
        }

        .details-titel {
            font-size: 30px;
        }

        .details-paneel {
            padding: 22px;
        }
    }
</style>

<div class="details-pagina">
    <div class="details-kruimelpad">
        Beheer / Wedstrijden / <strong>Details</strong>
    </div>

    <div class="details-hero">
        <div class="details-hero-inhoud">
            <div class="details-label">
                Wedstrijddetails
            </div>

            <h1 class="details-titel">
                @Model.Naam
            </h1>

            <p class="details-ondertitel">
                Bekijk hier de wedstrijdgegevens en de locatie.
            </p>
        </div>

        <a asp-controller="WedstrijdBeheer"
           asp-action="Index"
           class="details-terug">
            ← Terug naar overzicht
        </a>
    </div>

    <div class="details-inhoud">
        <section class="details-paneel">
            <div class="details-paneel-header">
                <div class="details-nummer">01</div>

                <div>
                    <h2>Wedstrijdgegevens</h2>
                    <p>Datum, deadline en wedstrijdlink</p>
                </div>
            </div>

            <div class="details-datumkaart">
                <div class="details-datumblok">
                    <span class="details-dag">
                        @Model.Datum.ToString("dd")
                    </span>

                    <span class="details-maand">
                        @Model.Datum.ToString("MMM")
                    </span>
                </div>

                <div class="details-datumtekst">
                    <span>Datum wedstrijd</span>

                    <strong>
                        @Model.Datum.ToString("dd/MM/yyyy")
                    </strong>
                </div>
            </div>

            <div class="details-velden">
                <div class="details-veld details-veld-breed">
                    <span>Deadline inschrijving</span>

                    <strong>
                        @Model.DeadlineInschrijven.ToString("dd/MM/yyyy HH:mm")
                    </strong>
                </div>

                <div class="details-veld details-veld-breed">
                    <span>Wedstrijdlink</span>

                    @if (string.IsNullOrWhiteSpace(Model.UrlWedstrijd))
                    {
                        <strong>Geen link beschikbaar</strong>
                    }
                    else
                    {
                        <strong>@Model.UrlWedstrijd</strong>
                    }
                </div>
            </div>
        </section>

        <section class="details-paneel">
            <div class="details-paneel-header">
                <div class="details-nummer">02</div>

                <div>
                    <h2>Locatie</h2>
                    <p>Waar de wedstrijd plaatsvindt</p>
                </div>
            </div>

            @if (plaats == null)
            {
                <p class="details-opmerking">
                    Er is geen locatie gevonden voor deze wedstrijd.
                </p>
            }
            else
            {
                <div class="details-veld">
                    <span>Naam locatie</span>
                    <strong>@plaats.Naam</strong>
                </div>

                <div class="details-scheiding"></div>

                <div class="details-velden">
                    <div class="details-veld details-veld-breed">
                        <span>Adres</span>
                        <strong>@plaats.Straat @plaats.HuisNummer</strong>
                    </div>

                    <div class="details-veld">
                        <span>Gemeente</span>
                        <strong>@plaats.Postcode @plaats.Gemeente</strong>
                    </div>

                    <div class="details-veld">
                        <span>Land</span>

                        @if (string.IsNullOrWhiteSpace(plaats.Land))
                        {
                            <strong>Niet opgegeven</strong>
                        }
                        else
                        {
                            <strong>@plaats.Land</strong>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>