@model Zwemclub.ViewModels.AccountAanmakenViewModel

@{
    ViewData["Title"] = "Account aanmaken";
}

<h1>Account aanmaken</h1>

<form asp-controller="AccountAanmaken" asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Voornaam" class="form-label"></label>
        <input asp-for="Voornaam" class="form-control" />
        <span asp-validation-for="Voornaam" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Naam" class="form-label"></label>
        <input asp-for="Naam" class="form-control" />
        <span asp-validation-for="Naam" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Geboortedatum" class="form-label"></label>
        <input asp-for="Geboortedatum" type="date" class="form-control" />
        <span asp-validation-for="Geboortedatum" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GeslachtId" class="form-label"></label>
        <select asp-for="GeslachtId"
                asp-items="ViewBag.Geslachten"
                class="form-select">
            <option value="">Selecteer een geslacht</option>
        </select>
        <span asp-validation-for="GeslachtId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Emailadres" class="form-label"></label>
        <input asp-for="Emailadres" class="form-control" />
        <span asp-validation-for="Emailadres" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefoonnummer" class="form-label"></label>
        <input asp-for="Telefoonnummer" class="form-control" />
        <span asp-validation-for="Telefoonnummer" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" class="form-select">
            <option value="">Selecteer een rol</option>
            <option value="Zwemmer">Zwemmer</option>
            <option value="Ouder">Ouder</option>
        </select>
        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Wachtwoord" class="form-label"></label>
        <input asp-for="Wachtwoord" class="form-control" />
        <span asp-validation-for="Wachtwoord" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BevestigWachtwoord" class="form-label"></label>
        <input asp-for="BevestigWachtwoord" class="form-control" />
        <span asp-validation-for="BevestigWachtwoord" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Account aanmaken</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}