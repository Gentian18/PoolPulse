@model Zwemclub.ViewModels.AccountAanmakenViewModel
@{
    ViewData["Title"] = "Account aanmaken";
    Layout = "_AuthLayout";
    ViewData["AuthLabel"] = "Jouw zwemclub, jouw plek";
    ViewData["AuthHeading"] = "Samen maken we golven.";
    ViewData["AuthDescription"] = "Van je eerste training tot je volgende wedstrijd: bij PoolPulse zwem je nooit alleen.";
}

<section class="auth-form-panel auth-form-panel-wide" aria-labelledby="registratie-titel">
    <header>
        <p class="auth-eyebrow">Duik mee met ons</p>
        <h1 id="registratie-titel">Maak je account aan.</h1>
        <p class="auth-intro">Al lid van de club? <a asp-controller="Gebruiker" asp-action="Login">Meld je aan</a></p>
    </header>

    <div class="auth-steps" aria-label="Stappen voor registratie" hidden>
        <span class="auth-step is-active" data-step-indicator="1"><span>1</span> Jouw gegevens</span>
        <span class="auth-step-line" aria-hidden="true"></span>
        <span class="auth-step" data-step-indicator="2"><span>2</span> Account</span>
    </div>

    <form asp-controller="AccountAanmaken" asp-action="Index" method="post" class="auth-form" data-register-form>
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
        <div class="auth-register-grid" data-register-step="1">
            <fieldset class="auth-role-field">
                <legend>Ik schrijf me in als</legend>
                <div class="auth-role-options">
                    <label><input asp-for="Rol" type="radio" value="Zwemmer" id="rol-zwemmer" /> Zwemmer</label>
                    <label><input asp-for="Rol" type="radio" value="Ouder" id="rol-ouder" /> Ouder</label>
                </div>
                <span asp-validation-for="Rol" class="account-validation"></span>
            </fieldset>
            <div class="account-field">
                <label asp-for="Voornaam"></label>
                <input asp-for="Voornaam" class="account-input" autocomplete="given-name" />
                <span asp-validation-for="Voornaam" class="account-validation"></span>
            </div>
            <div class="account-field">
                <label asp-for="Naam">Achternaam</label>
                <input asp-for="Naam" class="account-input" autocomplete="family-name" />
                <span asp-validation-for="Naam" class="account-validation"></span>
            </div>
            <div class="account-field">
                <label asp-for="Geboortedatum"></label>
                <input asp-for="Geboortedatum" type="date" class="account-input" />
                <span asp-validation-for="Geboortedatum" class="account-validation"></span>
            </div>
            <div class="account-field">
                <label asp-for="GeslachtId"></label>
                <select asp-for="GeslachtId" asp-items="ViewBag.Geslachten" class="account-input">
                    <option value="">Selecteer een geslacht</option>
                </select>
                <span asp-validation-for="GeslachtId" class="account-validation"></span>
            </div>
            <div class="account-field auth-grid-wide">
                <label asp-for="Telefoonnummer"></label>
                <input asp-for="Telefoonnummer" class="account-input" autocomplete="tel" />
                <span asp-validation-for="Telefoonnummer" class="account-validation"></span>
            </div>
            <button type="button" class="auth-button auth-grid-wide" data-register-next hidden>Volgende stap <span aria-hidden="true">→</span></button>
        </div>
        <div class="auth-register-grid" data-register-step="2">
            <div class="account-field auth-grid-wide">
                <label asp-for="Emailadres"></label>
                <input asp-for="Emailadres" class="account-input" autocomplete="email" placeholder="naam@voorbeeld.be" />
                <span asp-validation-for="Emailadres" class="account-validation"></span>
            </div>
            <div class="account-field auth-grid-wide">
                <label asp-for="Wachtwoord"></label>
                <input asp-for="Wachtwoord" type="password" class="account-input" autocomplete="new-password" />
                <span asp-validation-for="Wachtwoord" class="account-validation"></span>
            </div>
            <div class="account-field auth-grid-wide">
                <label asp-for="BevestigWachtwoord"></label>
                <input asp-for="BevestigWachtwoord" type="password" class="account-input" autocomplete="new-password" />
                <span asp-validation-for="BevestigWachtwoord" class="account-validation"></span>
            </div>
            <button type="submit" class="auth-button auth-grid-wide">Account aanmaken <span aria-hidden="true">→</span></button>
            <button type="button" class="auth-back auth-grid-wide" data-register-back hidden>← Terug naar jouw gegevens</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
