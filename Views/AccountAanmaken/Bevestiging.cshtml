@model Zwemclub.ViewModels.AccountBevestigingViewModel

@{
    ViewData["Title"] = "Account aangemaakt";
}

<div class="account-page">
    <header class="account-header">
        <p class="account-label">Welkom bij onze zwemclub</p>
        <h1>Account aangemaakt</h1>
        <p>Je bent klaar om samen met ons het water in te duiken.</p>
    </header>

    <section class="account-card account-confirmation">
        <span class="account-confirmation-icon" aria-hidden="true">✓</span>

        <h2>Je account is aangemaakt</h2>
        <p>Je bent nu aangemeld. Welkom bij de zwemclub!</p>

        <h3>Jouw gegevens</h3>
        <dl class="account-details">
            <dt>Voornaam</dt><dd>@Model.Voornaam</dd>
            <dt>Achternaam</dt><dd>@Model.Naam</dd>
            <dt>Geboortedatum</dt><dd>@Model.Geboortedatum?.ToString("dd/MM/yyyy")</dd>
            <dt>Geslacht</dt><dd>@Model.Geslacht</dd>
            <dt>E-mailadres</dt><dd>@Model.Emailadres</dd>
            <dt>Telefoonnummer</dt><dd>@Model.Telefoonnummer</dd>
            <dt>Rol</dt><dd>@Model.Rol</dd>
        </dl>

        <div class="account-actions">
            <a asp-controller="Home"
               asp-action="Index"
               class="account-button">
                Naar de startpagina
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
</div>
