@model Zwemclub.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Aanmelden";
}

<style>
    .login-pagina {
        max-width: 560px;
        margin: 35px auto 60px;
        padding: 32px;
        border: 1px solid #D8EAF2;
        border-radius: 24px;
        background: linear-gradient(145deg, #E6F3FA 0%, #F1F8FB 55%, #E4F1F7 100%);
        box-shadow: 0 18px 50px rgba(11, 31, 59, 0.08);
        font-family: Arial, Helvetica, sans-serif;
        color: #0B1F3B;
    }

    .login-hero {
        padding: 38px;
        border-radius: 18px;
        background: linear-gradient(120deg, #0B1F3B 0%, #10345C 65%, #14537A 100%);
        box-shadow: 0 14px 28px rgba(11, 31, 59, 0.18);
        color: #FFFFFF;
    }

    .login-label {
        margin-bottom: 12px;
        color: #46E2D0;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.6px;
        text-transform: uppercase;
    }

    .login-hero h1 {
        margin: 0 0 12px;
        color: #FFFFFF;
        font-size: 38px;
        font-weight: 700;
        letter-spacing: -1px;
        line-height: 1.1;
    }

    .login-omschrijving {
        margin: 0;
        color: #B9CEDD;
        font-size: 15px;
        line-height: 1.6;
    }

    .login-paneel {
        margin-top: 22px;
        padding: 25px;
        border: 1px solid #DDEBF2;
        border-radius: 16px;
        background: #FFFFFF;
        box-shadow: 0 12px 30px rgba(25, 69, 98, 0.09);
    }

    .login-fout {
        margin-bottom: 18px;
        padding: 12px 14px;
        border-left: 6px solid #0B1F3B;
        border-radius: 9px;
        background: #F3F9FC;
        color: #0B1F3B;
        font-size: 14px;
        font-weight: 700;
    }

        .login-fout.validation-summary-valid {
            display: none;
        }

    .login-veld {
        display: flex;
        flex-direction: column;
        margin-bottom: 18px;
    }

        .login-veld label {
            display: block;
            margin-bottom: 8px;
            color: #0B1F3B;
            font-size: 13px;
            font-weight: 700;
        }

        .login-veld input {
            min-height: 44px;
            padding: 10px 13px;
            border: 1px solid #D6E3EB;
            border-radius: 9px;
            background: #FFFFFF;
            color: #0B1F3B;
            font-size: 15px;
        }

            .login-veld input:focus {
                outline: 2px solid #A9CAF9;
                border-color: #1769E8;
            }

    .login-veldfout {
        margin-top: 6px;
        color: #0B1F3B;
        font-size: 13px;
        font-weight: 700;
    }

    .login-onthoud {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
        color: #0B1F3B;
        font-size: 13px;
        font-weight: 700;
    }

        .login-onthoud input {
            width: 18px;
            height: 18px;
        }

    .login-knop {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-height: 44px;
        padding: 10px 18px;
        border: 1px solid #1769E8;
        border-radius: 9px;
        background: #1769E8;
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

        .login-knop:hover {
            background: #1059CA;
            color: #FFFFFF;
        }

    @@media (max-width: 600px) {
        .login-pagina {
            margin: 20px auto 40px;
            padding: 16px;
        }

        .login-hero {
            padding: 27px;
        }

            .login-hero h1 {
                font-size: 30px;
            }
    }
</style>

<section class="login-pagina" aria-labelledby="login-titel">
    <div class="login-hero">
        <p class="login-label">Onze zwemclub</p>
        <h1 id="login-titel">Aanmelden</h1>
        <p class="login-omschrijving">Meld je aan met je e-mailadres en wachtwoord om naar je dashboard te gaan.</p>
    </div>

    <div class="login-paneel">
        <form asp-controller="Gebruiker" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="login-fout" role="alert"></div>

            <div class="login-veld">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="login-veldfout"></span>
            </div>

            <div class="login-veld">
                <label asp-for="Wachtwoord"></label>
                <input asp-for="Wachtwoord" autocomplete="current-password" />
                <span asp-validation-for="Wachtwoord" class="login-veldfout"></span>
            </div>

            <div class="login-onthoud">
                <input asp-for="Onthoud" />
                <label asp-for="Onthoud"></label>
            </div>

            <button type="submit" class="login-knop">Aanmelden</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}