@{
    ViewData["Title"] = "Home";
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="hero-title">
        <div class="home-hero-content">
            <p class="home-label">Welkom bij onze zwemclub</p>
            <h1 id="hero-title">Samen maken we <span>golven.</span></h1>
            <p class="home-intro">Van je eerste baantje tot je volgende wedstrijd: bij onze zwemclub zwemmen we samen vooruit.</p>
            <a class="home-button home-button-aqua" href="#inschrijven">Word lid <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-water" aria-hidden="true">
            <svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="181" cy="66" r="18" fill="white" fill-opacity=".95" />
                <path d="M112 121l39-26 38 25 32-17" stroke="white" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M55 151c18 0 18 12 36 12s18-12 36-12 18 12 36 12 18-12 36-12 18 12 36 12 18-12 36-12" stroke="white" stroke-opacity=".9" stroke-width="8" stroke-linecap="round" />
                <path d="M73 184c18 0 18 12 36 12s18-12 36-12 18 12 36 12 18-12 36-12 18 12 36 12" stroke="white" stroke-opacity=".5" stroke-width="8" stroke-linecap="round" />
            </svg>
        </div>
    </section>

    <section class="home-about" aria-labelledby="about-title">
        <p class="home-section-label">Onze zwemclub</p>
        <h2 id="about-title">Samen sterker in het water</h2>
        <p class="home-section-intro">Zwemmen is meer dan baantjes trekken. In onze club staan samen trainen, plezier maken en groeien als zwemmer centraal.</p>
        <div class="home-cards">
            <article class="home-card">
                <span class="home-card-number" aria-hidden="true">01</span>
                <h3>Samen trainen</h3>
                <p>Werk samen met andere zwemmers aan je techniek en ontdek hoe fijn het is om vooruitgang te boeken.</p>
            </article>
            <article class="home-card">
                <span class="home-card-number" aria-hidden="true">02</span>
                <h3>Groeien op jouw tempo</h3>
                <p>Van de eerste meters tot nieuwe uitdagingen: elke zwemmer volgt zijn eigen traject.</p>
            </article>
            <article class="home-card">
                <span class="home-card-number" aria-hidden="true">03</span>
                <h3>Samen naar wedstrijden</h3>
                <p>Deel de spanning van wedstrijden en moedig elkaar aan, in en naast het water.</p>
            </article>
        </div>
    </section>

    <section id="inschrijven" class="home-signup" aria-labelledby="signup-title">
        <p class="home-section-label">Zwem met ons mee</p>
        <h2 id="signup-title">Klaar om de sprong te wagen?</h2>
        <p>Leuk dat je interesse hebt in onze zwemclub. Online inschrijven is binnenkort beschikbaar.</p>
    </section>
</div>
